#!/bin/sh /etc/rc.common
# lanweave-routerd procd init script (feature 031).
# Install: copy to /etc/init.d/lanweave-routerd && chmod +x && /etc/init.d/lanweave-routerd enable

START=95
STOP=10
USE_PROCD=1

PROG=/usr/bin/lanweave-routerd

start_service() {
	procd_open_instance
	procd_set_param command "$PROG" run
	# Crash → respawn (threshold 3600s, 5s delay, unlimited retries).
	procd_set_param respawn 3600 5 0
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	# procd has already SIGTERM'd the daemon (graceful interface teardown);
	# this is the belt-and-braces cleanup for a daemon that died uncleanly.
	"$PROG" down >/dev/null 2>&1 || true
}
